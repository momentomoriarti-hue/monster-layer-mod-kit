# Monster Layer Mod Kit
# Only the kit itself goes into git: scripts, the mod kit code (Player Tools/build), templates
# (with the example Lay, boss and mod_settings.cfg), and the docs. Everything below is either the game
# (copyrighted, never upload it), generated by the scripts, downloaded by
# setup-tools.bat, or personal.

# The game: put your own copy into Original Packed. The folder is kept by .gitkeep.
/Original Packed/*
!/Original Packed/.gitkeep

# Generated by the scripts.
/Original Unpacked/
/Moded Unpacked/
/Moded Packed/

# Downloaded by setup-tools.bat (or by hand, see README), plus the video cache.
/Tools/

# Your own custom Lays and bosses. The examples in them are copied by
# setup-tools.bat from Scripts/templates/, which is the copy kept in git.
/Custom Lays/
/Custom Bosses/

# Plain-text preview of the f95zone post.
/f95zone-post-plain.txt

# Made by the Player Tools on each PC: downloaded tools, the unpacked original game,
# remembered paths and the Windows Sandbox staging folder. Only the .bat files and
# the README are in git.
/Player Tools/tools/
/Player Tools/cache/
/Player Tools/sandbox/
/Player Tools/original_game.txt
/Player Tools/game_folder.txt

# Mod source zips made by pack-moded-source.bat (and .pck files built from them).
/Moded Source/

# Your own mod settings; setup-tools.bat creates it from Scripts\templates.
/mod_settings.cfg

# Game packs, executables and check-mod.bat reports anywhere else in the repo
# (a mod you checked, a copy of the game): never part of the kit.
*.pck
*.exe
*.check.txt

# Windows and editor leftovers.
Thumbs.db
desktop.ini
*.tmp
*.bak
